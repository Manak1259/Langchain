import os
import argparse
import json
import subprocess
import base64
import dns.resolver
import requests
from distutils.util import strtobool

try:
    import infoblox.common.ilog as ilog
except:
    # custom ilog for unit testing
    import logging
    class UTLogger(logging.Logger):
        def log(self, msg, *args, **kwargs):
            super().log(logging.INFO, msg, *args, **kwargs)
        def debug(self, msg, *args, **kwargs):
            super().log(logging.DEBUG, msg, *args, **kwargs)
    logging.setLoggerClass(UTLogger)
    ilog = logging.getLogger(__name__)
    ilog.setLevel(logging.INFO)

try:
    import infoblox.common.util as util
except:
    # custom util for unit testing
    class UTUtil:
        def iexec_output_status(self, *cmdlist):
            p = subprocess.Popen(cmdlist,
                          close_fds=True,
                          stdin=open('/dev/null'),
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            return (p.communicate()[0], p.returncode)
    util = UTUtil()

DEFAULT_CSP_URL = "csp.infoblox.com"
DEFAULT_NGP_CP_URL = "cp.noa.infoblox.com:443"
PARAMS_JSON_PATH = '/storage/noa/onprem.d/params.json'
AGENT_CONF_PATH = '/storage/noa/onprem.d/agent.conf'
RESOLVER_TIMEOUT = 5
API_TIMEOUT = 10
REALM_DISCOVERY_DOMAIN = "realm-discovery.csp.infoblox.com"
REALM_RESOLVER_URL = "https://provision.ib-hub.na.csp.infoblox.com/api/realm_resolver/v1/dns/discovery/resolve"

