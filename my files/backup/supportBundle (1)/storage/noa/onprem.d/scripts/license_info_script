#!/usr/bin/python
import os
import subprocess
import argparse
import sys
import json
import string
import infoblox.one.onedb as onedb

def dump_json(data):
    print (json.dumps(data))
    sys.exit(0)

def get_db_data(db, obj):
    return db.call(obj, factory=onedb.todict)

def get_members():
    members = []
    db = onedb.Db()
    with db.begin(onedb.RO) as txn:
       pnode = get_db_data(db, '?one.physical_node')
       if pnode:
           for i, node in enumerate(pnode):
               members.append(node['serial_number'])
    return members 

def parse_static_license_info_command(licenseString):
    members = get_members()
    for item in members:
        command = "/infoblox/common/bin/get_license_info -i " + item + " -s " + licenseString
        licenseInfo = subprocess.Popen(command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                shell=True)
        first_line = licenseInfo.stdout.readline()
        if (sys.version_info[0] == 3):
            license_info_str = first_line.decode()
        else:
            license_info_str = first_line

        # Successful out from the binary always starts with the below line.
        if (license_info_str == 'The license contains such info:\n'):
            # Return Static and code 0 on Success
            message = " Success : " + licenseString + "," + item
            dump_json({'kind':0,'code':0,'serial':item,'message':message})

    membersStr = ':'.join([str(elem) for elem in members])    
    message = " Static license decrypt failure : " + licenseString + "," + membersStr
    dump_json({'kind':0,'date':"",'code':1,'message':message})


def parse_grid_license_info_command(licenseString, hwId):
    command = "/infoblox/common/bin/get_license_info -i " + hwId + " -s " + licenseString
    licenseInfo = subprocess.Popen(command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                shell=True)
    first_line = licenseInfo.stdout.readline()
    # Successful out from the binary always starts with the below line.
    if (sys.version_info[0] == 3):
        license_info_str = first_line.decode()
    else:
        license_info_str = first_line

    if (license_info_str == 'The license contains such info:\n'):
        for line_entry in iter(licenseInfo.stdout.readline, b''):
            if (sys.version_info[0] == 3):
                line = line_entry.decode()
            else:
                line = line_entry

            # Skip the first line
            if (line == "The license contains such info:"):
                 continue
            # Skip empty line
            if (line == '\n'):
                continue
            # Output format is kind:month:day:year
            line = line.strip()
            if "[Grid-wide]" in line:
                # Return GRID_WIDE and code 0 on Success
                message = " Success : " + licenseString + "," + hwId
                dump_json({'kind':3,'code':0,'message':message})
    else:
        message = " Grid license decrypt error : " + licenseString + "," + hwId
        dump_json({'kind':0,'date':"",'code':1,'message':message})

if __name__ == "__main__":

    try:
        my_parser = argparse.ArgumentParser()
        my_parser.add_argument('--s', action='store', type=str, required=True)
        my_parser.add_argument('--i', action='store', type=str)

        args = my_parser.parse_args()

        licenseString = args.s
        hwId = args.i
        if hwId != None:
            parse_grid_license_info_command(licenseString, hwId)
        else:
            parse_static_license_info_command(licenseString)
    except Exception as e:
        # Return code 1 on failure
        dump_json({'kind':0,'date':"",'code':1,'message':str(e)})
